+// lost-recomp debug: say which early exit of IssueDraw a draw took, and log draws that bind a
+// k_8 texture (Bink planes). Rate-limited; off by default.
+REXCVAR_DEFINE_BOOL(gpu_log_draw_drops, false, "GPU/D3D12",
+                    "Debug: log draws IssueDraw drops (and why) and draws binding k_8 textures")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+namespace {
+std::atomic<uint32_t> g_draw_drop_logs{0};
+void LogDrawDrop(const char* reason, const rex::graphics::Shader* vs,
+                 const rex::graphics::Shader* ps, uint32_t prim, uint32_t count) {
+  if (!REXCVAR_GET(gpu_log_draw_drops) || g_draw_drop_logs.fetch_add(1) >= 400) return;
+  REXGPU_INFO("Draw dropped ({}): prim {} count {} VS {:016X} PS {:016X}", reason, prim, count,
+              vs ? vs->ucode_data_hash() : 0, ps ? ps->ucode_data_hash() : 0);
+}
+}  // namespace
